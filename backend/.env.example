# Ambiente
NODE_ENV=development
PORT=4000

# Banco de dados
DATABASE_URL=postgresql://brasa_user:brasa_password@localhost:5432/brasa_db

# Autenticacao
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECRET=

# CORS
CORS_ORIGIN=http://localhost:5173

# E-mail transacional (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BRASA Restaurante <reservas@brasa.example>"
RESTAURANT_NOTIFICATION_EMAIL=contato@brasa.example

# Seguranca
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_PUBLIC=60
