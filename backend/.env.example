# Ambiente
NODE_ENV=development
PORT=4000

# Banco de dados
DATABASE_URL=

# Autenticacao
# Em producao, JWT_SECRET e COOKIE_SECRET devem ser diferentes e ter pelo menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECRET=

# CORS
# Local: http://localhost:5173
# Producao: URL exata do frontend, ex.: https://brasa.vercel.app
CORS_ORIGIN=http://localhost:5173

# E-mail transacional (OPCIONAL)
# Se voce nao usa envio de e-mail, deixe todas as variaveis abaixo vazias/ausentes.
# Se SMTP_HOST for configurado em producao, SMTP_USER, SMTP_PASSWORD e SMTP_FROM tambem serao obrigatorios.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESTAURANT_NOTIFICATION_EMAIL=

# Seguranca (opcional; existem valores padrao)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_PUBLIC=60
